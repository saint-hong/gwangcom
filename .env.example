# ─────────────────────────────────────────────────────────────
# Imagine 환경 변수 예시 — 복사해서 .env 로 쓰세요:  cp .env.example .env
# .env 는 git 에 올리지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 앱 ──
APP_ENV=dev                       # dev | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# ── PostgreSQL (docker-compose 의 postgres 서비스와 같은 값) ──
POSTGRES_USER=imagine
POSTGRES_PASSWORD=imagine_local_pw
POSTGRES_PORT=5432                # PC 에 이미 PostgreSQL 이 5432 를 쓰고 있으면 5433 등으로 변경
DATABASE_URL=postgresql+psycopg://imagine:imagine_local_pw@localhost:5432/imagine_dev
TEST_DATABASE_URL=postgresql+psycopg://imagine:imagine_local_pw@localhost:5432/imagine_test

# ── 인증 (JWT) ──
# 운영에서는 반드시 긴 임의 문자열로 바꾸세요:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=10080          # 7일

# ── 업로드 이미지 ──
UPLOAD_DIR=data/uploads

# ── Memgraph (분석용 그래프 복사본, Sprint 7 에서 사용) ──
GRAPH_ENABLED=true
GRAPH_URI=bolt://localhost:7687

# ── LLM (Sprint 4 — 기획안 9-1장). 키가 없으면 fake (가짜 응답, 비용 0) ──
LLM_PROVIDER=fake                   # anthropic | fake   (local 은 추후)
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low                      # low | medium | high
# 기능별 덮어쓰기 (비워 두면 위 값)
LLM_TAGGING_PROVIDER=
LLM_TAGGING_MODEL=
LLM_SHAKE_PROVIDER=
LLM_SHAKE_MODEL=
LLM_NOTE_PROVIDER=
LLM_NOTE_MODEL=
LLM_SIMILAR_PROVIDER=
LLM_SIMILAR_MODEL=
LLM_SUMMARY_PROVIDER=               # 운영자 사용자 활동 요약 (비우면 LLM_PROVIDER)
LLM_SUMMARY_MODEL=
ANTHROPIC_API_KEY=                  # Claude 콘솔에서 발급. git 에 올리지 않는다
LLM_DAILY_CALL_LIMIT=300
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# ── 임베딩 (Sprint 4 — 기획안 9-3장). 키가 없으면 fake ──
EMBEDDING_PROVIDER=fake             # gemini | fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                   # DB 칸 크기와 같아야 한다
GEMINI_API_KEY=                     # Google AI Studio 에서 발급. git 에 올리지 않는다
EMBEDDING_PRICE_PER_MTOK=0.15
SIMILAR_THRESHOLD=0.85
SIMILAR_CANDIDATES=20   # 리랭킹 1단계 후보 수
SIMILAR_SHOW=5          # 상세 화면에 보여 줄 수
